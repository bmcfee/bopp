{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "v1/core.json",
  "title": "BOPP Core Primitives",
  "$defs": {
    "Array": {
      "type": "array",
      "description": "A dense columnar array buffer."
    },
    "Fraction": {
        "type": "array",
        "description": "Rational number encoded as numerator and non-zero denominator",
        "minItems": 2,
        "maxItems": 2,
        "prefixItems": [
            {
              "type": "integer",
              "description": "Numerator, signed integer"
            },
            {
              "type": "integer",
              "minimum": 1,
              "description": "Denominator. Strictly positive to prevent zero-division and negative bases."
            }
        ],
        "items": false
    },
    "FractionNonnegative": {
        "type": "array",
        "description": "Non-negative rational number",
        "minItems": 2,
        "maxItems": 2,
        "prefixItems": [
            {
              "type": "integer",
              "minimum": 0,
              "description": "Numerator, non-negative integer"
            },
            {
              "type": "integer",
              "minimum": 1,
              "description": "Denominator. Strictly positive to prevent zero-division and negative bases."
            }
        ],
        "items": false
    }

  }
}
