{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "extents.json",
  "title": "Any Extent",
  "description": "A discriminated union of all supported columnar extent types.",
  "oneOf": [
    { "$ref": "extent/time.json" },
    { "$ref": "extent/time_interval.json" },
    { "$ref": "extent/time_frequency_box.json" },
    { "$ref": "extent/time_uniform.json" },
    { "$ref": "extent/pixel.json" },
    { "$ref": "extent/pixel_box.json" },
    { "$ref": "extent/text.json" },
    { "$ref": "extent/text_interval.json" },
    { "$ref": "extent/spherical.json" },
    { "$ref": "extent/spherical_time.json" },
    { "$ref": "extent/spherical_time_interval.json" },
    { "$ref": "extent/cartesian.json" },
    { "$ref": "extent/cartesian_time.json" },
    { "$ref": "extent/cartesian_time_interval.json" },
    { "$ref": "extent/score_quarter.json" },
    { "$ref": "extent/score_interval.json" },
    { "$ref": "extent/score_quarter_float.json" },
    { "$ref": "extent/score_interval_float.json" },
    { "$ref": "extent/midi_tick.json" },
    { "$ref": "extent/midi_interval.json" }
  ],
  "discriminator": {
    "propertyName": "extent_type"
  }
}
