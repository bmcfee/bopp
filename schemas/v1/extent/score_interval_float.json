{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "extent/score_interval_float.json",
  "title": "Score Interval (float)",
  "type": "object",
  "properties": {
    "extent_type": {
      "const": "score_interval_float"
    },
    "quarter": {
      "$ref": "../core.json#/$defs/Array",
      "description": "Array of interval start times in quarter notes, as floating-point numbers.",
      "items": {
        "type": "number"
      }
    },
    "duration": {
      "$ref": "../core.json#/$defs/Array",
      "description": "Array of interval durations in quarter notes, as floating-point numbers.",
      "items": {
        "type": "number",
        "minimum": 0.0
      }
    },
    "disjoint": {
      "type": "boolean",
      "description": "Indicates whether all quarter intervals in the extent are non-overlapping."
    },
    "exhaustive": {
      "type": "boolean",
      "description": "Indicates whether quarter intervals fully cover the range without gaps."
    },
    "min_quarter": {
      "type": "number",
      "description": "Lower bound in quarter notes."
    },
    "max_quarter": {
      "type": "number",
      "description": "Upper bound in quarter notes."
    }
  },
  "required": [
    "extent_type",
    "quarter",
    "duration",
    "disjoint",
    "exhaustive"
  ]
}
