{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "extents/quarters_time_fraction.json",
  "title": "Quarters Time Fraction",
  "type": "object",
  "properties": {
    "extent_type": {
      "const": "quarters_time.fraction"
    },
    "quarter": {
      "$ref": "../core.json#/$defs/Array",
      "description": "Array of time points in fractional quarter notes.",
      "items": {
        "$ref": "../core.json#/$defs/Fraction"
      }
    }
  },
  "required": ["extent_type", "quarter"]
}
