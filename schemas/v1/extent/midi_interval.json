{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "extents/midi_interval.json",
  "title": "MIDI Interval",
  "type": "object",
  "properties": {
    "extent_type": {
      "const": "midi_interval"
    },
    "tick": {
      "$ref": "../core.json#/$defs/Array",
      "description": "Array of interval start times in MIDI ticks.",
      "items": {
        "type": "number"
      }
    },
    "duration": {
      "$ref": "../core.json#/$defs/Array",
      "description": "Array of interval durations in MIDI ticks.",
      "items": {
        "type": "number",
        "minimum": 0.0
      }
    }
  },
  "required": ["extent_type", "tick", "duration"]
}
