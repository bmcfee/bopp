{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "extent/midi_interval.json",
  "title": "MIDI Interval",
  "type": "object",
  "properties": {
    "extent_type": {
      "const": "midi_interval"
    },
    "tick": {
      "$ref": "../core.json#/$defs/Array",
      "description": "Array of interval start times in MIDI ticks.",
      "items": {
        "type": "number"
      }
    },
    "duration": {
      "$ref": "../core.json#/$defs/Array",
      "description": "Array of interval durations in MIDI ticks.",
      "items": {
        "type": "number",
        "minimum": 0.0
      }
    },
    "disjoint": {
      "type": "boolean",
      "description": "Indicates whether all MIDI intervals in the extent are non-overlapping."
    },
    "exhaustive": {
      "type": "boolean",
      "description": "Indicates whether MIDI intervals fully cover the tick range without gaps."
    },
    "min_tick": {
      "type": "number",
      "description": "Lower bound in MIDI ticks."
    },
    "max_tick": {
      "type": "number",
      "description": "Upper bound in MIDI ticks."
    }
  },
  "required": [
    "extent_type",
    "tick",
    "duration",
    "disjoint",
    "exhaustive"
  ]
}
