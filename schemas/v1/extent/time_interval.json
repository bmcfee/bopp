{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "extents/time_interval.json",
  "title": "Time Interval Extent",
  "type": "object",
  "properties": {
    "extent_type": {
      "const": "time_interval"
    },
    "time": {
      "$ref": "../core.json#/$defs/GenericBuffer",
      "description": "Array of start time timestamps in seconds.",
      "items": {
        "type": "number",
        "minimum": 0.0
      }
    },
    "duration": {
      "$ref": "../core.json#/$defs/GenericBuffer",
      "description": "Array of interval durations in seconds.",
      "items": {
        "type": "number",
        "minimum": 0.0
      }
    }
  },
  "required": ["extent_type", "time", "duration"]
}
