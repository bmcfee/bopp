{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "extent/score_quarter.json",
  "title": "Score quarter notes",
  "type": "object",
  "properties": {
    "extent_type": {
      "const": "score_quarter"
    },
    "quarter": {
      "$ref": "../core.json#/$defs/Array",
      "description": "An array of fractional quarter values.",
      "items": {
        "$ref": "../core.json#/$defs/Fraction"
      }
    },
    "disjoint": {
      "type": "boolean",
      "description": "Indicates whether all quarter positions are unique.",
      "default": false
    },
    "exhaustive": {
      "type": "boolean",
      "description": "Indicates whether quarter observations cover the range without missing observations.",
      "default": false
    },
    "min_quarter": {
      "$ref": "../core.json#/$defs/Fraction",
      "description": "Lower bound in quarter notes."
    },
    "max_quarter": {
      "$ref": "../core.json#/$defs/Fraction",
      "description": "Upper bound in quarter notes."
    }
  },
  "required": [
    "extent_type",
    "quarter",
    "disjoint",
    "exhaustive"
  ]
}
