{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "extents/score_quarter.json",
  "title": "Score quarter notes",
  "type": "object",
  "properties": {
    "extent_type": {
      "const": "score_quarter"
    },
    "quarter": {
      "$ref": "../core.json#/$defs/Array",
      "description": "An array of fractional quarter values.",
      "items": {
        "$ref": "../core.json#/$defs/Fraction"
      }
    }
  },
  "required": ["extent_type", "quarter"]
}
