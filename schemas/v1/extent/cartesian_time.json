{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "extent/cartesian_time.json",
  "title": "Cartesian Time Extent",
  "description": "Spatiotemporal point coordinates in Cartesian space with timestamps.",
  "type": "object",
  "properties": {
    "extent_type": {
      "const": "cartesian_time"
    },
    "time": {
      "$ref": "../core.json#/$defs/Array",
      "description": "Array of point timestamps in seconds.",
      "items": {
        "type": "number"
      }
    },
    "x": {
      "$ref": "../core.json#/$defs/Array",
      "description": "Array of x-coordinates in space.",
      "items": {
        "type": "number"
      }
    },
    "y": {
      "$ref": "../core.json#/$defs/Array",
      "description": "Array of y-coordinates in space.",
      "items": {
        "type": "number"
      }
    },
    "z": {
      "$ref": "../core.json#/$defs/Array",
      "description": "Array of z-coordinates in space.",
      "items": {
        "type": "number"
      }
    }
  },
  "required": ["extent_type", "time", "x", "y", "z"]
}
