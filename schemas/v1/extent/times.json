{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "extents/times.json",
  "title": "Timestamps",
  "type": "object",
  "properties": {
    "extent_type": {
      "const": "timestamps"
    },
    "time": {
      "$ref": "../core.json#/$defs/Float32Buffer",
      "description": "An N array of time values.",
      "items": {
        "type": "number",
        "minimum": 0.0
      }
    }
  },
  "required": ["extent_type", "time"]
}
