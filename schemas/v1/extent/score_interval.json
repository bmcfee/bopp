{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "extent/score_interval.json",
  "title": "Score Interval",
  "type": "object",
  "properties": {
    "extent_type": {
      "const": "score_interval"
    },
    "quarter": {
      "$ref": "../core.json#/$defs/Array",
      "description": "Array of interval start times in fractional quarter notes.",
      "items": {
        "$ref": "../core.json#/$defs/Fraction"
      }
    },
    "duration": {
      "$ref": "../core.json#/$defs/Array",
      "description": "Array of interval durations in fractional quarter notes.",
      "items": {
        "$ref": "../core.json#/$defs/FractionNonnegative"
      }
    },
    "disjoint": {
      "type": "boolean",
      "description": "Indicates whether all quarter intervals in the extent are non-overlapping.",
      "default": false
    },
    "exhaustive": {
      "type": "boolean",
      "description": "Indicates whether quarter intervals fully cover the range without gaps.",
      "default": false
    },
    "min_quarter": {
      "$ref": "../core.json#/$defs/Fraction",
      "description": "Lower bound in quarter notes."
    },
    "max_quarter": {
      "$ref": "../core.json#/$defs/Fraction",
      "description": "Upper bound in quarter notes."
    }
  },
  "required": [
    "extent_type",
    "quarter",
    "duration",
    "disjoint",
    "exhaustive"
  ]
}
