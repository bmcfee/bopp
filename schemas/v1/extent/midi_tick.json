{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "extent/midi_tick.json",
  "title": "MIDI Ticks",
  "type": "object",
  "properties": {
    "extent_type": {
      "const": "midi_tick"
    },
    "tick": {
      "$ref": "../core.json#/$defs/Array",
      "description": "An array of MIDI tick values.",
      "items": {
        "type": "number"
      }
    },
    "disjoint": {
      "type": "boolean",
      "description": "Indicates whether all MIDI tick values are unique."
    },
    "exhaustive": {
      "type": "boolean",
      "description": "Indicates whether MIDI tick observations cover the range without missing observations."
    },
    "min_tick": {
      "type": "number",
      "description": "Lower bound in MIDI ticks."
    },
    "max_tick": {
      "type": "number",
      "description": "Upper bound in MIDI ticks."
    }
  },
  "required": [
    "extent_type",
    "tick",
    "disjoint",
    "exhaustive"
  ]
}
