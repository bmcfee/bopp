{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "extent/pixel_box.json",
  "title": "Pixel Box Extent",
  "type": "object",
  "properties": {
    "extent_type": {
      "const": "pixel_box"
    },
    "x": {
      "$ref": "../core.json#/$defs/Array",
      "description": "Array of x-coordinates in pixels.",
      "items": {
        "type": "number"
      }
    },
    "width": {
      "$ref": "../core.json#/$defs/Array",
      "description": "Array of box widths in pixels.",
      "items": {
        "type": "number",
        "minimum": 0.0
      }
    },
    "y": {
      "$ref": "../core.json#/$defs/Array",
      "description": "Array of y-coordinates in pixels.",
      "items": {
        "type": "number"
      }
    },
    "height": {
      "$ref": "../core.json#/$defs/Array",
      "description": "Array of box heights in pixels.",
      "items": {
        "type": "number",
        "minimum": 0.0
      }
    },
    "disjoint": {
      "type": "boolean",
      "description": "Indicates whether all pixel boxes in the extent are non-overlapping."
    },
    "exhaustive": {
      "type": "boolean",
      "description": "Indicates whether the pixel boxes fully cover the pixel range without gaps."
    },
    "min_x": {
      "type": "number",
      "description": "Lower bound along x-axis in pixels."
    },
    "max_x": {
      "type": "number",
      "description": "Upper bound along x-axis in pixels."
    },
    "min_y": {
      "type": "number",
      "description": "Lower bound along y-axis in pixels."
    },
    "max_y": {
      "type": "number",
      "description": "Upper bound along y-axis in pixels."
    }
  },
  "required": [
    "extent_type",
    "x",
    "width",
    "y",
    "height",
    "disjoint",
    "exhaustive"
  ]
}
