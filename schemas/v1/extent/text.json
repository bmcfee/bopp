{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "extent/text.json",
  "title": "Text",
  "description": "Character point offsets in text.",
  "type": "object",
  "properties": {
    "extent_type": {
      "const": "text"
    },
    "offset": {
      "$ref": "../core.json#/$defs/Array",
      "description": "Array of 0-based character offsets in text.",
      "items": {
        "type": "integer",
        "minimum": 0
      }
    },
    "disjoint": {
      "type": "boolean",
      "description": "Indicates whether all character offsets are unique.",
      "default": false
    },
    "exhaustive": {
      "type": "boolean",
      "description": "Indicates whether all character positions in the range are observed.",
      "default": false
    },
    "min_offset": {
      "type": "integer",
      "minimum": 0,
      "description": "Lower bound character offset."
    },
    "max_offset": {
      "type": "integer",
      "minimum": 0,
      "description": "Upper bound character offset."
    }
  },
  "required": [
    "extent_type",
    "offset",
    "disjoint",
    "exhaustive"
  ]
}
