{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "extents/time_frequency_box.json",
  "title": "Time-Frequency Box Extent",
  "type": "object",
  "properties": {
    "extent_type": {
      "const": "TimeFrequencyBox"
    },
    "coordinates": {
      "$ref": "../core.json#/$defs/GenericBuffer",
      "description": "An N x 4 array of time-frequency bounding bxoes. Each inner array is [start_time, duration] in seconds.",
      "items": {
        "type": "array",
        "items": [
          { "type": "number", "minimum": 0.0, "description": "Time" },
          { "type": "number", "minimum": 0.0, "description": "Duration" },
          { "type": "number", "minimum": 0.0, "description": "Minimum frequency in Hz" }, 
          { "type": "number", "minimum": 0.0, "description": "Maximum frequency in Hz" }
        ],
        "minItems": 4,
        "maxItems": 4
      }
    }
  },
  "required": ["extent_type", "coordinates"]
}
