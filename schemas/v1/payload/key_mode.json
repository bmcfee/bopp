{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "payload/key_mode.json",
  "title": "Key_Mode Payload",
  "type": "object",
  "properties": {
    "payload_type": {
      "const": "key_mode"
    },
    "value": {
      "$ref": "../core.json#/$defs/StringArray",
      "description": "Key and optional mode (major/minor or Greek modes)",
      "items": {
        "type": "string",
        "pattern": "^((N)|(([A-G]([b\u266d]*|\ud834\udd2b|[#\u266f]*|\ud834\udd2a|\u266e))(:(major|minor|ionian|dorian|phrygian|lydian|mixolydian|aeolian|locrian))?))$"
      }
    }
  },
  "required": [
    "payload_type",
    "value"
  ]
}
