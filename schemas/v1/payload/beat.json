{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "payload/beat.json",
  "title": "Beat Position Payload",
  "type": "object",
  "properties": {
    "payload_type": {
      "const": "beat"
    },
    "values": {
      "$ref": "../core.json#/$defs/UInt8Buffer",
      "description": "The metric position of the beat within the measure (e.g., 1 for downbeat, 2, 3, 4).",
      "items": {
        "type": "integer",
        "minimum": 1
      }
    }
  },
  "required": ["payload_type", "values"]
}
