{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "payload/note.json",
  "title": "Note Payload",
  "type": "object",
  "properties": {
    "payload_type": {
      "const": "note"
    },
    "value": {
      "$ref": "../core.json#/$defs/StringArray",
      "description": "Musical notes in scientific pitch notation (e.g. C4, A4, C\u266f4, E\u266d3, F\ud834\udd2a5, B\ud834\udd2b2, D\u266e4, C-1)",
      "items": {
        "type": "string",
        "pattern": "^[A-G]([b\u266d]*|\ud834\udd2b|[#\u266f]*|\ud834\udd2a|\u266e)-?[0-9]+$"
      }
    }
  },
  "required": [
    "payload_type",
    "value"
  ]
}
