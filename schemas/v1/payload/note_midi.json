{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "payload/note_midi.json",
  "title": "Note_Midi Payload",
  "type": "object",
  "properties": {
    "payload_type": {
      "const": "note_midi"
    },
    "values": {
      "type": "array",
      "description": "Note pitches in (fractional) MIDI note numbers",
      "items": {
        "type": "number"
      }
    }
  },
  "required": [
    "payload_type",
    "values"
  ]
}