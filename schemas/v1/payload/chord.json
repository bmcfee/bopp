        "pattern": "^((N|X)|(([A-G]([b\u266d]*|\ud834\udd2b|[#\u266f]*|\ud834\udd2a|\u266e))((:(maj|min|dim|aug|1|5|sus2|sus4|maj6|min6|7|maj7|min7|dim7|hdim7|minmaj7|aug7|9|maj9|min9|11|maj11|min11|13|maj13|min13)(\\((\\*?(([b\u266d]*|\ud834\udd2b|[#\u266f]*|\ud834\udd2a|\u266e)([1-9]|1[0-3]?))(,\\*?(([b\u266d]*|\ud834\udd2b|[#\u266f]*|\ud834\udd2a|\u266e)([1-9]|1[0-3]?)))*)\\))?)|(:\\((\\*?(([b\u266d]*|\ud834\udd2b|[#\u266f]*|\ud834\udd2a|\u266e)([1-9]|1[0-3]?))(,\\*?(([b\u266d]*|\ud834\udd2b|[#\u266f]*|\ud834\udd2a|\u266e)([1-9]|1[0-3]?)))*)\\)))?((/(([b\u266d]*|\ud834\udd2b|[#\u266f]*|\ud834\udd2a|\u266e)([1-9]|1[0-3]?)))?)?))$"
