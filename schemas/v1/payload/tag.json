{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "payload/tag.json",
  "title": "Tag Payload",
  "type": "object",
  "properties": {
    "payload_type": {
      "const": "tag"
    },
    "value": {
      "$ref": "../core.json#/$defs/Array",
      "description": "Tag vocabularies allow all strings",
      "items": {
        "type": "string"
      }
    }
  },
  "required": [
    "payload_type",
    "value"
  ]
}
