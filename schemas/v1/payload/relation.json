{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "payload/relation.json",
  "title": "Relation Payload",
  "description": "Columnar payload defining relationships between works (covers, quotes, etc).",
  "type": "object",
  "properties": {
    "payload_type": {
        "const": "relation"
    },
    "performance_id": {
        "type": "string"
    },
    "value": {
      "$ref": "../core.json#/$defs/Array",
      "items": {
        "type": "string"
      },
      "description": "Array of referenced work or clique identifiers."
    },
    "relation": {
      "$ref": "../core.json#/$defs/Array",
      "items": {
        "type": "string",
        "enum": ["cover", "quote", "medley_part", "sample", "interpolation", "remix", "live_performance"]
      },
      "description": "Array of relation types parallel to value."
    }
  },
  "required": ["payload_type", "performance_id", "value"],
  "additionalProperties": false
}
