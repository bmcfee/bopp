{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "payload/multi_segment.json",
  "title": "Multi_Segment Payload",
  "type": "object",
  "properties": {
    "payload_type": {
      "const": "multi_segment"
    },
    "label": {
      "$ref": "../core.json#/$defs/GenericBuffer",
      "description": "Multi-level segmentation labels.",
      "items": {
        "type": "string"
      }
    },
    "level": {
      "$ref": "../core.json#/$defs/GenericBuffer",
      "description": "Multi-level segmentation levels.",
      "items": {
        "type": "integer",
        "minimum": 0
      }
    }
  },
  "required": [
    "payload_type",
    "label",
    "level"
  ]
}
